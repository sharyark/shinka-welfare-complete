# Copy to .env and fill in. Never commit .env to Git.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use SQLite. With Docker (db published on port 5433): postgres://shinka:shinka@localhost:5433/shinka
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173

# CNIC encryption. Optional in development; REQUIRED in production. Back them up safely:
# if they are lost, stored CNIC numbers can never be read again.
# FIELD_ENCRYPTION_KEYS=   (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# CNIC_HASH_PEPPER=        (any long random string; never change it once data exists)
